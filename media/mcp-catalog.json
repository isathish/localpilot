{
  "version": 1,
  "servers": [
    {
      "id": "filesystem",
      "name": "Filesystem",
      "tagline": "Read, write, search and move files inside the folders you allow.",
      "tags": [
        "files",
        "local",
        "official"
      ],
      "repo": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
      "install": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "${env:ALLOWED_DIR}"
        ],
        "env": [
          {
            "name": "ALLOWED_DIR",
            "required": true,
            "description": "Folder the server may read and write",
            "secret": false,
            "default": "${workspaceFolder}",
            "arg": true
          }
        ]
      }
    },
    {
      "id": "git",
      "name": "Git",
      "tagline": "Read, search and change a Git repository: log, diff, status, commit, branches.",
      "tags": [
        "git",
        "local",
        "official",
        "python"
      ],
      "repo": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
      "install": {
        "command": "uvx",
        "args": [
          "mcp-server-git",
          "--repository",
          "${env:REPOSITORY}"
        ],
        "env": [
          {
            "name": "REPOSITORY",
            "required": true,
            "description": "Path of the repository",
            "secret": false,
            "default": "${workspaceFolder}",
            "arg": true
          }
        ]
      }
    },
    {
      "id": "github",
      "name": "GitHub",
      "tagline": "Issues, pull requests, code search, Actions and repositories on GitHub.",
      "tags": [
        "git",
        "remote",
        "oauth",
        "official"
      ],
      "repo": "https://github.com/github/github-mcp-server",
      "install": {
        "command": "docker",
        "args": [
          "run",
          "-i",
          "--rm",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server"
        ],
        "env": [
          {
            "name": "GITHUB_PERSONAL_ACCESS_TOKEN",
            "required": true,
            "description": "A GitHub personal access token",
            "url": "https://github.com/settings/personal-access-tokens"
          }
        ]
      },
      "remote": {
        "url": "https://api.githubcopilot.com/mcp/"
      }
    },
    {
      "id": "gitlab",
      "name": "GitLab",
      "tagline": "Projects, issues, merge requests and files on GitLab.",
      "tags": [
        "git",
        "api"
      ],
      "repo": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/gitlab",
      "install": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-gitlab"
        ],
        "env": [
          {
            "name": "GITLAB_PERSONAL_ACCESS_TOKEN",
            "required": true,
            "description": "A GitLab personal access token",
            "url": "https://gitlab.com/-/user_settings/personal_access_tokens"
          },
          {
            "name": "GITLAB_API_URL",
            "required": false,
            "description": "API URL for self-hosted GitLab (default https://gitlab.com/api/v4)",
            "secret": false
          }
        ]
      }
    },
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "tagline": "Inspect schemas and run read-only SQL against a PostgreSQL database.",
      "tags": [
        "database",
        "sql"
      ],
      "repo": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/postgres",
      "install": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-postgres",
          "${env:DATABASE_URL}"
        ],
        "env": [
          {
            "name": "DATABASE_URL",
            "required": true,
            "description": "Connection string, e.g. postgresql://user:pass@localhost/db",
            "arg": true
          }
        ]
      }
    },
    {
      "id": "sqlite",
      "name": "SQLite",
      "tagline": "Query and analyse a local SQLite database file.",
      "tags": [
        "database",
        "sql",
        "local",
        "python"
      ],
      "repo": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/sqlite",
      "install": {
        "command": "uvx",
        "args": [
          "mcp-server-sqlite",
          "--db-path",
          "${env:DB_PATH}"
        ],
        "env": [
          {
            "name": "DB_PATH",
            "required": true,
            "description": "Path of the database file",
            "secret": false,
            "arg": true
          }
        ]
      }
    },
    {
      "id": "mongodb",
      "name": "MongoDB",
      "tagline": "Query collections and manage MongoDB and Atlas clusters.",
      "tags": [
        "database"
      ],
      "repo": "https://github.com/mongodb-js/mongodb-mcp-server",
      "install": {
        "command": "npx",
        "args": [
          "-y",
          "mongodb-mcp-server",
          "--readOnly"
        ],
        "env": [
          {
            "name": "MDB_MCP_CONNECTION_STRING",
            "required": true,
            "description": "MongoDB connection string"
          }
        ]
      }
    },
    {
      "id": "redis",
      "name": "Redis",
      "tagline": "Read and write keys in a Redis database.",
      "tags": [
        "database"
      ],
      "repo": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/redis",
      "install": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-redis",
          "${env:REDIS_URL}"
        ],
        "env": [
          {
            "name": "REDIS_URL",
            "required": true,
            "description": "Redis URL",
            "secret": false,
            "default": "redis://localhost:6379",
            "arg": true
          }
        ]
      }
    },
    {
      "id": "supabase",
