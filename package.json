{
  "name": "localpilot-agent",
  "displayName": "LocalPilot Agent",
  "description": "The AI coding agent that runs on your machine. Copilot-style agent mode with Ollama, LM Studio, llama.cpp or vLLM — private, offline, free.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "keywords": [
    "ollama",
    "lm studio",
    "local llm",
    "copilot",
    "ai agent"
  ],
  "publisher": "localpilot",
  "author": {
    "name": "Sathishkumar Nagarajan",
    "url": "https://github.com/isathish"
  },
  "license": "MIT",
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#15181d",
    "theme": "dark"
  },
  "homepage": "https://isathish.github.io/localpilot/",
  "repository": {
    "type": "git",
    "url": "https://github.com/isathish/localpilot.git"
  },
  "bugs": {
    "url": "https://github.com/isathish/localpilot/issues"
  },
  "badges": [
    {
      "url": "https://github.com/isathish/localpilot/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/isathish/localpilot/actions/workflows/ci.yml",
      "description": "CI"
    }
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
