    "configuration": {
      "title": "LocalPilot",
      "properties": {
        "localpilot.providers": {
          "type": "array",
          "markdownDescription": "Local/remote model servers. `type` is `ollama` (native API) or `openai` (any OpenAI-compatible server: LM Studio, llama.cpp, vLLM, SGLang, Unsloth/llama-server, LocalAI, Jan, OpenRouter…). Models are referenced as `<id>/<model>`.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "baseUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Short unique id, e.g. ollama, lmstudio"
              },
              "type": {
                "type": "string",
                "enum": [
                  "ollama",
                  "openai"
                ]
              },
              "baseUrl": {
                "type": "string",
                "description": "e.g. http://localhost:11434 or http://localhost:1234/v1"
              },
              "apiKey": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Explicit model ids when the server does not list them"
              },
              "contextWindow": {
                "type": "number",
                "description": "Fallback context window when the server does not report it"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "default": [
            {
              "id": "ollama",
              "type": "ollama",
              "baseUrl": "http://localhost:11434",
              "displayName": "Ollama"
            },
            {
              "id": "lmstudio",
              "type": "openai",
              "baseUrl": "http://localhost:1234/v1",
              "displayName": "LM Studio"
            },
            {
              "id": "llamacpp",
              "type": "openai",
              "baseUrl": "http://localhost:8080/v1",
              "displayName": "llama.cpp server"
            },
            {
              "id": "vllm",
              "type": "openai",
              "baseUrl": "http://localhost:8000/v1",
              "displayName": "vLLM / Unsloth"
            }
          ]
        },
        "localpilot.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model as provider/model (e.g. ollama/qwen2.5-coder:14b). Empty = auto-pick the best tool-capable local model."
        },
        "localpilot.contextWindow": {
          "type": "number",
          "default": 32768,
          "description": "Requested context window (num_ctx for Ollama). Capped by the model's maximum."
        },
        "localpilot.maxOutputTokens": {
          "type": "number",
          "default": 4096
        },
        "localpilot.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2
        },
        "localpilot.thinking": {
          "type": "string",
          "enum": [
            "off",
            "on",
            "low",
            "medium",
            "high"
          ],
          "default": "off",
          "description": "Extended thinking for reasoning models (Ollama `think`, OpenAI-compatible `reasoning_effort`). Reasoning is shown as a collapsible step."
        },
        "localpilot.keepAlive": {
          "type": "string",
          "default": "30m",
          "description": "How long Ollama keeps the model loaded after a request (e.g. 5m, 30m, -1 for forever). Avoids reload latency between turns."
        },
        "localpilot.memory.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Let the agent read and save durable notes in .localpilot/memory (project) and global storage (user)."
        },
        "localpilot.sessions.retention": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "Maximum number of chats kept in this workspace's history. The oldest idle chats are removed automatically when a new one is created; pinned and running chats are never removed. 0 keeps everything."
        },
        "localpilot.compactionThreshold": {
          "type": "number",
          "default": 0.75,
          "minimum": 0.3,
          "maximum": 0.95,
          "description": "Fraction of the context window at which older messages are pruned and summarised."
        },
        "localpilot.maxToolOutputChars": {
          "type": "number",
          "default": 24000,
          "description": "Tool outputs longer than this are truncated (head + tail) before being sent to the model."
        },
        "localpilot.approvals.terminal": {
          "type": "string",
          "enum": [
            "always",
            "ask",
            "never"
          ],
          "default": "ask",
          "description": "Approval policy for running shell commands."
        },
        "localpilot.approvals.write": {
          "type": "string",
          "enum": [
            "always",
            "ask",
            "never"
          ],
          "default": "always",
          "description": "Approval policy for creating/editing files."
        },
        "localpilot.approvals.delete": {
          "type": "string",
          "enum": [
            "always",
            "ask",
            "never"
          ],
          "default": "ask"
        },
        "localpilot.approvals.network": {
          "type": "string",
          "enum": [
            "always",
            "ask",
            "never"
          ],
          "default": "always",
          "description": "Approval policy for web search / fetch and MCP tools."
        },
        "localpilot.parallel.maxConcurrency": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Max concurrent tool calls / subagents."
        },
        "localpilot.parallel.maxSubagentDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4
        },
        "localpilot.autoClarify": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When a request is short, vague or refers to \"this\"/\"it\" without naming a target, give the agent a snapshot of the active editor, open files, recent edits, errors and git changes so it can state its interpretation (`Understood as: …`) and proceed, asking only when two readings would lead to materially different work."
        },
        "localpilot.webSearch.provider": {
          "type": "string",
          "enum": [
            "duckduckgo",
            "searxng",
            "brave",
            "tavily"
          ],
          "default": "duckduckgo",
          "description": "duckduckgo needs no key; searxng is self-hosted; brave/tavily need an API key."
        },
        "localpilot.webSearch.searxngUrl": {
          "type": "string",
          "default": "http://localhost:8888"
        },
        "localpilot.webSearch.apiKey": {
          "type": "string",
          "default": ""
        },
        "localpilot.webSearch.maxResults": {
          "type": "number",
          "default": 6
        },
        "localpilot.inlineCompletion.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Ghost-text completions from a local FIM model (qwen2.5-coder, codestral, starcoder2…)."
        },
        "localpilot.inlineCompletion.model": {
          "type": "string",
          "default": "",
          "description": "provider/model for completions. Empty = the smallest FIM-capable model that fits this machine."
        },
        "localpilot.inlineCompletion.debounceMs": {
          "type": "number",
          "default": 350
        },
        "localpilot.inlineCompletion.maxTokens": {
          "type": "number",
          "default": 128
        },
        "localpilot.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "MCP servers (stdio) whose tools are exposed to the agent, e.g. `{ \"filesystem\": { \"command\": \"npx\", \"args\": [\"-y\", \"@modelcontextprotocol/server-filesystem\", \".\"] } }`",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "localpilot.skillsPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra folders containing skills (each skill is a folder with SKILL.md). `.localpilot/skills`, `.claude/skills`, `.github/skills`, `~/.agents/skills` are scanned automatically."
        },
        "localpilot.skills.builtin": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Load the skills bundled with LocalPilot (requirements, design, implement, test, debug, review, deploy, …). A workspace or user skill with the same name overrides the bundled one; copy a bundled skill from the extension's `skills/` folder into `.localpilot/skills/` to customise it."
        },
        "localpilot.systemPromptAppend": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "description": "Extra instructions appended to the system prompt (coding conventions, preferences…)."
        },
        "localpilot.showWelcomeOnStartup": {
          "type": "boolean",
          "default": true,
          "order": 0,
          "markdownDescription": "Open the **Welcome / Setup** screen the first time LocalPilot starts without a reachable model server or default model. Run it again any time with *LocalPilot: Welcome / Setup*."
        },
        "localpilot.models.autoSetup": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When no local model is found, offer to set one up automatically: start or install Ollama and download the smallest coder model that suits this machine (plus a tiny completion model when it fits)."
        },
        "localpilot.models.disabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "`provider/model` ids hidden from the model picker, routing and the status bar. Toggle models in **Settings → Models** instead of editing this by hand."
        },
        "localpilot.routing.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pick the right model per task automatically: a vision model for turns with images, the smallest fill-in-the-middle model for inline completions, the configured reasoning model in Plan mode, and the best available model when the default is offline or disabled."
        },
        "localpilot.routing.vision": {
          "type": "string",
          "default": "",
          "description": "provider/model used for turns that include images when the session model cannot see. Empty = best available vision model."
        },
        "localpilot.browser.chromePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a Chromium-based browser used for headless web-page screenshots (`browser_screenshot` tool, *Screenshot a Web Page…*). Empty = auto-detect Chrome, Chromium, Edge, Brave or Arc."
        },
        "localpilot.routing.reasoning": {
          "type": "string",
          "default": "",
          "description": "provider/model used in Plan mode (e.g. ollama/qwen3:8b or ollama/deepseek-r1:8b). Empty = keep the session model."
        },
        "localpilot.routing.fast": {
          "type": "string",
          "default": "",
          "markdownDescription": "provider/model for read-only subagents (`explore`, `clarifier`, `researcher`), which run many short tool calls in parallel. Empty = the smallest tool-capable model that fits this machine; `session` = always use the session model."
        },
        "localpilot.routing.coding": {
          "type": "string",
          "default": "",
          "markdownDescription": "provider/model for implementing subagents (`coder`, `tester`, `debugger`, `docs`). Empty = keep the session model."
        },
        "localpilot.terminal.runInIntegratedTerminal": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run the agent's `run_command` calls in a visible **LocalPilot Agent** terminal (via shell integration) so you can watch them live. Falls back to a hidden process when the shell has no integration or when disabled."
        },
        "localpilot.terminal.reveal": {
          "type": "boolean",
          "default": true,
          "description": "Show the LocalPilot Agent terminal (without stealing focus) when the agent runs a command."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "localpilot.gettingStarted",
        "title": "Get started with LocalPilot",
        "description": "Connect a local model server, pick a model and run your first agent task — all on your machine.",
        "steps": [
          {
            "id": "setup",
            "title": "Connect a model server",
            "description": "LocalPilot works with Ollama, LM Studio, llama.cpp, vLLM or any OpenAI-compatible endpoint. The setup screen finds running servers and recommends a model — or installs Ollama and a model sized for this machine in one click.\n[Open setup](command:localpilot.openWelcome)\n[Manage models](command:localpilot.manageModels)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onCommand:localpilot.openWelcome",
              "onSettingChanged:localpilot.defaultModel"
            ]
          },
          {
            "id": "chat",
            "title": "Open the chat",
            "description": "Ask questions, or switch to **Agent** mode to let LocalPilot plan, edit files and run commands with your approval.\n[Open chat](command:localpilot.openChat)",
            "media": {
              "markdown": "media/walkthrough/chat.md"
            },
            "completionEvents": [
              "onCommand:localpilot.openChat",
              "onView:localpilot.chatView"
            ]
          },
          {
            "id": "approvals",
            "title": "Decide how autonomous the agent is",
            "description": "Choose **Careful**, **Balanced** or **Autonomous**, or set each approval individually. Every file edit is tracked and can be undone.\n[Agent & approvals](command:localpilot.openSettings?%22agent%22)",
            "media": {
              "markdown": "media/walkthrough/approvals.md"
            },
            "completionEvents": [
              "onSettingChanged:localpilot.approvals.terminal",
              "onSettingChanged:localpilot.approvals.write"
            ]
          },
          {
            "id": "parallel",
            "title": "Run agents in parallel",
            "description": "Give several tasks at once — each runs as its own agent while you keep working.\n[Run tasks in parallel](command:localpilot.runParallelTasks)",
            "media": {
              "markdown": "media/walkthrough/parallel.md"
            },
            "completionEvents": [
              "onCommand:localpilot.runParallelTasks"
            ]
          },
          {
            "id": "completions",
            "title": "Turn on inline completions",
            "description": "Ghost-text from a small local FIM model such as `qwen2.5-coder:1.5b-base`.\n[Inline completions](command:localpilot.openSettings?%22completions%22)",
            "media": {
              "markdown": "media/walkthrough/completions.md"
            },
            "completionEvents": [
              "onSettingChanged:localpilot.inlineCompletion.enabled"
            ]
          }
        ]
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "localpilot.terminalProfile",
          "title": "LocalPilot",
          "icon": "localpilot-logo"
        }
      ]
    },
    "icons": {
      "localpilot-logo": {
        "description": "LocalPilot logo",
        "default": {
          "fontPath": "media/localpilot.woff",
          "fontCharacter": "\\e900"
        }
      },
      "localpilot-spark": {
        "description": "LocalPilot spark (thinking / highlight)",
        "default": {
          "fontPath": "media/localpilot.woff",
          "fontCharacter": "\\e901"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "smoke": "node scripts/run-smoke.js",
    "release": "node scripts/release.js",
    "check:version": "node scripts/check-version.js",
    "test": "vscode-test",
    "icons": "node scripts/build-icon-font.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
