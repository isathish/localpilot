        "view": "localpilot.agentsView",
        "contents": "Every chat is an independent agent. Run several at once and review their changes here.\n[Run tasks in parallel](command:localpilot.runParallelTasks)\n[New chat](command:localpilot.newSession)\n\nNeed to connect a model server? [Open setup](command:localpilot.openWelcome) · [Settings](command:localpilot.openSettings)"
      }
    ],
    "chatParticipants": [
      {
        "id": "localpilot.agent",
        "name": "localpilot",
        "fullName": "LocalPilot",
        "description": "Local-model coding agent with tools, skills and subagents",
        "isSticky": true,
        "commands": [
          {
            "name": "agent",
