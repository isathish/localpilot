    "viewsContainers": {
      "activitybar": [
        {
          "id": "localpilot",
          "title": "LocalPilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "localpilot": [
        {
          "type": "webview",
          "id": "localpilot.chatView",
          "name": "Chat",
          "icon": "media/icon.svg",
          "contextualTitle": "LocalPilot"
        },
        {
          "id": "localpilot.agentsView",
